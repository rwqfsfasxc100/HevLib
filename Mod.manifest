[mod_information]

name="HevLib"
id="hev.LIBRARY"
description="HEVLIB_MOD_DESCRIPTION"
brief="HEVLIB_MOD_BRIEF"
author="__hev"
credits=PoolStringArray( "HEVLIB_CREDITS_CONTRIBUTORS_HEADER", "HEVLIB_CREDITS_CONTRIBUTORS_ZAKRIN", "HEVLIB_CREDITS_CONTRIBUTORS_SPDX", "HEVLIB_CREDITS_CONTRIBUTORS_1WT1", "HEVLIB_CREDITS_CONTRIBUTORS_HEDRAUTA", "", "HEVLIB_CREDITS_SUPPORTERS_HEADER", "HEVLIB_CREDITS_SUPPORTERS_KOFI_GAZI", "HEVLIB_CREDITS_SUPPORTERS_KOFI_BAGGERDUDE", "HEVLIB_CREDITS_SUPPORTERS_KOFI_1WT1", "HEVLIB_CREDITS_SUPPORTERS_KOFI_TESSIER" )

[version]

